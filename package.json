{
  "name": "vysion-analytics",
  "version": "2.0.0",
  "description": "Football Talent Scouting Platform - Mobile-first cross-platform ecosystem",
  "private": true,
  "workspaces": ["apps/*", "services/*", "packages/*", "database"],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:mobile\"",
    "dev:backend": "npm run dev --workspace=@vysion/backend",
    "dev:mobile": "npm run start --workspace=@vysion/mobile",
    "build": "npm run build:shared && npm run build:backend",
    "build:shared": "npm run build --workspace=@vysion/shared",
    "build:backend": "npm run build --workspace=@vysion/backend",
    "type-check": "npm run type-check:shared && npm run type-check:backend && npm run type-check:mobile",
    "type-check:shared": "npm run type-check --workspace=@vysion/shared",
    "type-check:backend": "npm run type-check --workspace=@vysion/backend",
    "type-check:mobile": "npm run type-check --workspace=@vysion/mobile",
    "test": "npm run test:backend && npm run test:mobile",
    "test:backend": "npm run test --workspace=@vysion/backend",
    "test:mobile": "npm run test --workspace=@vysion/mobile",
    "db:migrate": "npm run migrate --workspace=@vysion/database",
    "db:generate": "npm run generate --workspace=@vysion/database",
    "db:studio": "npm run studio --workspace=@vysion/database",
    "db:seed": "npm run seed --workspace=@vysion/database",
    "clean": "node -e \"for (const p of ['node_modules','apps/mobile/node_modules','services/api/node_modules','packages/shared/node_modules','database/node_modules','apps/mobile/dist','services/api/dist','packages/shared/dist']) require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "fresh": "npm run clean && npm install"
  },
  "keywords": ["football", "scouting", "talent", "analytics", "react-native", "expo", "nodejs", "prisma", "firebase"],
  "author": "Vysion Analytics Team",
  "license": "MIT",
  "repository": {"type": "git", "url": "git+https://github.com/Hamez-brayo/football-scout.git"},
  "bugs": {"url": "https://github.com/Hamez-brayo/football-scout/issues"},
  "homepage": "https://github.com/Hamez-brayo/football-scout#readme",
  "devDependencies": {"concurrently": "^9.1.2"},
  "engines": {"node": ">=20.0.0", "npm": ">=10.0.0"}
}
